<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reading_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reading_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/reading_widget_title"
        android:textColor="@color/reading_widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/reading_widget_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/reading_widget_loading"
        android:textColor="@color/reading_widget_foreground"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
